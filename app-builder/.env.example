# Copy to .env (never commit .env). `aio app use` adds the AIO_* lines for your workspace.

# Sites allowed to call the proxy (comma-separated, * wildcards allowed)
ALLOWED_ORIGINS=http://localhost:3000,https://*--midwives--bhasakatech.aem.page,https://*--midwives--bhasakatech.aem.live

# users API
USERS_API_URL=https://gorest.co.in/public/v2/users
# optional, only for APIs that need a key; stays on the server
USERS_API_TOKEN=

# add each new API's <NAME>_API_URL / <NAME>_API_TOKEN here
